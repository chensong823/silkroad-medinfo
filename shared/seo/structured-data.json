  },
  "FAQPage": {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "胶囊胃镜检查前需要空腹吗？",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "需要。检查前一日进流食或半流食，禁食 8 至 10 小时。"
        }
      },
      {
        "@type": "Question",
        "name": "心脏冠脉核磁有没有辐射？",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "没有。磁共振成像使用磁场而非 X 射线，无电离辐射。"
        }
      },
      {
        "@type": "Question",
        "name": "检查报告多久能拿到？",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "胶囊胃镜 3 至 5 个工作日，心脏冠脉核磁 2 至 3 个工作日。"
        }
      }
    ]
